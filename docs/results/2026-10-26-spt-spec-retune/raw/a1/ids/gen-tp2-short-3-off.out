```rust
use std::collections::HashMap;
use std::fs;
use std::io::Read;

/// Reads a text file and returns a HashMap of word counts.
/// Words are lowercased and split on whitespace.
/// Returns a Result with the HashMap on success, or an error on failure.
pub fn count_words(file_path: &str) -> Result<HashMap<String, usize>, Box<dyn std::error::Error>> {
    // Read the file contents
    let mut contents = String::new();
    let mut file = fs::File::open(file_path)?;
    file.read_to_string(&mut contents)?;

    // Split on whitespace, lowercase each word, and count
    let mut word_counts: HashMap<String, usize> = HashMap::new();

    for word in contents.split_whitespace() {
        let lower_word = word.to_lowercase();
        *word_counts.entry(lower_word).or_insert(0) += 1;
    }

    Ok(word_counts)
}
```











