+    let wb = put_bytes(&be, 8, &rand_e4m3(n * k, 91, 0));
+    let wt = t(&wb, 8, DType::Fp8E4m3, &[n, k]);
+    let x = act_rows(m, k, 92);
+    let mut xsw = x.clone();
+    xsw[11 * k..12 * k].copy_from_slice(&x[12 * k..13 * k]); // rows 11 and 12 (both in the second 8-row tile) swapped
+    xsw[12 * k..13 * k].copy_from_slice(&x[11 * k..12 * k]);
+    let xt = t(&put_bytes(&be, 0, &bf16_bytes(&x)), 0, DType::Bf16, &[m, k]);
+    let xswt = t(&put_bytes(&be, 0, &bf16_bytes(&xsw)), 0, DType::Bf16, &[m, k]);
+    let st = t(&put_bytes(&be, 4, &f32_bytes(&[0.0123, 0.37])), 4, DType::F32, &[2]);
