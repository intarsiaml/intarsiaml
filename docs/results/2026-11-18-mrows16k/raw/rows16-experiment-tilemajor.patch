+        for (wi, w_off) in [8usize, 16].into_iter().enumerate() {
+            let w = rand_e4m3(n * k, 80 + si as u64, if wi == 1 { 997 } else { 0 });
+            let wb = put_bytes(&be, w_off, &w);
