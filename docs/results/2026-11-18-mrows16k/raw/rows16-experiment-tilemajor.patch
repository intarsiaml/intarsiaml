+        let d = differing(&solo, &got);
+        eprintln!("NEGATIVE CONTROL fp8 rows16 with {what}: {d} of {} output bytes differ", solo.len());
+        assert!(d > 0, "{what}: bitwise equal to the one-row launches, so the gate could not see it");
+    }
+}
