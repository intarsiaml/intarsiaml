+/// Lane mrows16k: `cargo test --release --test rows_exact -- --ignored --nocapture timing_fp8_rows16`: one decode step's `matmul_fp8_gemv_rows`
+/// launches of the 35B (40 x 8192x2048, 30 x 4096x2048, 40 x 2048x4096, 20 x 512x2048; weights cycled through up to 400 MB of copies so they are
+/// not cache-hot) at M = 5..=16 rows through `launch`: today's rule (`split`: halves, or `FP8_ROWS_PLAN` at 9..=12) against the opt-in
+/// 16-row tile (`r16`: one launch). Lines `ROWS16 m=M form=split|r16 us=U` (us per step), then per shape. Run in a quiet fleetq slot.
+#[test]
+#[ignore]
+fn timing_fp8_rows16() {
+    let be = backend();
+    let e = |kx, n, n1, k, f32o, count| KxEnt { kx, n, n1, k, f32o, count };
+    let ents = vec![
+        e(Kx::Fp8, 8192, 0, 2048, false, 40),
+        e(Kx::Fp8, 4096, 0, 2048, false, 30),
+        e(Kx::Fp8, 2048, 0, 4096, false, 40),
+        e(Kx::Fp8, 512, 0, 2048, false, 20),
+    ];
+    let calls: Vec<Vec<OpCall>> = ents.iter().enumerate().map(|(i, en)| kx_calls(&be, en, i)).collect();
+    for m in 5..=16usize {
+        let cur: Vec<Vec<OpCall>> = calls.iter().map(|vs| vs.iter().map(|c| kx_rows(c, 0, m)).collect()).collect();
+        for (form, on) in [("split", false), ("r16", true)] {
+            if on && m <= 8 {
+                continue;
+            }
+            let mut per = Vec::new();
+            let mut tot = 0.0;
+            for (en, vs) in ents.iter().zip(&cur) {
+                let us = intarsia_backend_metal::fp8::with_fp8_rows16(on, || {
+                    time_us(&be, 6, || {
+                        for i in 0..en.count {
+                            be.launch("matmul_fp8_gemv_rows", &vs[i % vs.len()], 0).unwrap();
+                        }
+                    })
+                });
+                tot += us;
+                per.push(format!("{}x{}:{us:.0}", en.n, en.k));
+            }
+            eprintln!("ROWS16 m={m} form={form} us={tot:.0} ({})", per.join(" "));
+        }
+    }
+}
