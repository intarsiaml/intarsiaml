import re
def load(p):
    txt=open(p).read(); out={}
    for f in re.split(r"\n\s*Function : ",txt)[1:]:
        name=f.split("\n")[0].strip()
        m=re.search(r"moe_w4a16_kernelILi(\d+)ELi(\d+)ELi(\d+)ELi(\d+)ELi(\d+)ELi(\d+)ELi(\d+)ELb(\d)E(Lb(\d)E)?",name)
        if not m: continue
        key=(m.group(1),m.group(2),m.group(3),m.group(4),m.group(8))
        pf = m.group(10)
        body=[]
        for l in f.split("\n")[1:]:
            mm=re.match(r"\s+/\*[0-9a-f]+\*/\s+(.*?)\s*;",l)
            if mm: body.append(mm.group(1))
        out[(key,pf)]=body
    return out
a=load("w4_basesrc.sass"); b=load("w4_src.sass")
print("main kernels",len(a),"dev kernels",len(b))
for (key,pf),body in sorted(b.items(), key=str):
    if pf=="1": continue
    ref=a.get((key,None))
    print(key,"PF=false", "IDENTICAL" if ref==body else "DIFF (%s vs %s instrs)"%(len(ref) if ref else None,len(body)))
PY'
