+/// DIAG (lane ink-decroof, never in the tree): launches built with InkP flag 32 (CONV_PRE), 64 (BIAS_PRE), 128 (BIAS_EARLY).
+pub static DIAG_CPRE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static DIAG_BPRE: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static DIAG_BEARLY: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+fn diag_flags() -> u32 {
+    let f = crate::inkctrl::attn_dec_flags();
+    for (b, c) in [(32, &DIAG_CPRE), (64, &DIAG_BPRE), (128, &DIAG_BEARLY)] {
+        if f & b != 0 {
+            c.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        }
+    }
+    f
+}
