    KERNEL["Kernel Dispatch: Dynamic dispatch to CUDA/HIP packs"]
    MEM["Memory: Unified buffer pool, pinned memory, NCCL buffers"]
  end
  subgraph Kernels["Kernel Packs (MIT/Apache-2.0)"]
    TF["TensorFold: GEMM, MoE, FlashAttention"]
    RAD["Radiance: Norm, Rope, Sampling, Quant-dequant"]
    PORTABLE["ik_portable.h: Shared intrinsics"]
  end
