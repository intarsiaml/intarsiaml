```rust
use std::collections::HashMap;
use std::fs;
use std::io::Read;

/// Reads a text file and returns a HashMap of word counts.
/// Words are lowercased and split on whitespace.
/// Returns a Result with the word count map or an error.
pub fn count_words_in_file(path: &str) -> Result<HashMap<String, usize>, Box<dyn std::error::Error>> {
    let mut file = fs::File::open(path)?;
    let mut contents = String::new();
    file.read_to_string(&mut contents)?;

    let mut word_counts: HashMap<String, usize> = HashMap::new();

    for word in contents.split_whitespace() {
        let lowercased = word.to_lowercase();
        *word_counts.entry(lowercased).or_insert(0) += 1;
    }

    Ok(word_counts)
}
