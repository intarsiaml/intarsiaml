"""Discount calculation for the billing service.

All monetary values are expressed in integer cents to avoid floating-point
rounding issues.  The discount percentage is an integer 0-100.
"""

from __future__ import annotations

import math
from typing import Optional


def apply_discount(
    cents: int,
    pct: int,
    cap: Optional[int] = None,
) -> int:
    """Return the discounted amount in cents.

    Parameters
    ----------
    cents : int
        Original amount in whole cents.  Must be >= 0.
    pct : int
        Discount percentage.  Must be an integer in [0, 100].
    cap : int, optional
        Maximum discount in cents.  If the computed discount exceeds this
        value, the discount is clamped to *cap*.  Must be >= 0 if given.

    Returns
    -------
    int
        The final amount in cents, guaranteed to be >= 0.

    Raises
    ------
    TypeError
