+/// `gemm_nax_glu_t` (SwiGLU epilogue): bitwise `matmul_pair_bf16_nax` followed by `silu_glu_bf16`, per tile, at M tails,
+/// N edges and odd operand offsets.
+#[test]
+fn nax_glu_is_bitwise_pair_then_silu_glu() {
+    let be = backend();
+    for &(m, n, k, xo, go, uo, co) in &[
+        (205usize, 1024usize, 4096usize, 0usize, 0usize, 8usize, 0usize),
+        (256, 4096, 4096, 0, 0, 0, 0),
+        (222, 1000, 512, 2, 2, 6, 2),
+        (17, 70, 64, 2, 2, 6, 0),
+        (1024, 12288, 4096, 0, 0, 0, 0),
+        (300, 130, 100, 0, 0, 0, 2),
+    ] {
+        let x = rand_bf16(m * k, 81);
+        let scale = 1.0 / (k as f32).sqrt();
+        let wt = |seed: u64| -> Vec<u16> {
+            rand_bf16(n * k, seed)
+                .iter()
+                .map(|&b| intarsia_backend_metal::bench::f32_to_bf16(intarsia_backend_metal::bench::bf16_to_f32(b) * scale))
+                .collect()
+        };
+        let (g, u) = (wt(82), wt(83));
+        let (xb, gb, ub) = (upload_at(&be, xo, &x), upload_at(&be, go, &g), upload_at(&be, uo, &u));
+        // reference: the shipped pair, then the shipped SiluGlu
+        let gy = be.alloc(m * n * 2, MemKind::Device).unwrap();
+        let uy = be.alloc(m * n * 2, MemKind::Device).unwrap();
+        let pair = intarsia_core::OpCall::new(
+            intarsia_core::Op::MatmulPair,
+            vec![tref(&xb, xo, &[m, k]), tref(&gb, go, &[n, k]), tref(&ub, uo, &[n, k])],
+            vec![tref(&gy, 0, &[m, n]), tref(&uy, 0, &[m, n])],
+            Default::default(),
+        );
+        be.launch(MATMUL_PAIR_BF16_NAX, &pair, 0).unwrap();
+        let want_b = be.alloc(co + m * n * 2 + 16, MemKind::Device).unwrap();
+        let silu = intarsia_core::OpCall::new(
+            intarsia_core::Op::SiluGlu,
+            vec![tref(&gy, 0, &[m, n]), tref(&uy, 0, &[m, n])],
+            vec![tref(&want_b, co, &[m, n])],
+            Default::default(),
+        );
+        be.launch(SILU_GLU_BF16, &silu, 0).unwrap();
+        be.synchronize(0).unwrap();
+        let want = read_u16(&be, &want_b, co, m * n);
+        for v in NAX_GLU_VARIANTS {
+            let cb = be.alloc(co + m * n * 2 + 16, MemKind::Device).unwrap();
+            be.upload(&cb, 0, &vec![0xEEu8; co + m * n * 2 + 16], 0).unwrap();
+            let pso = be.pso(v.shader).unwrap_or_else(|| panic!("no pipeline {}", v.shader));
+            let p = NaxPairParams {
+                m: m as u32,
+                n0: n as u32,
+                n1: n as u32,
+                k: k as u32,
+                s_a: ((xo & 3) / 2) as u32,
+                s_w0: ((go & 3) / 2) as u32,
+                s_w1: ((uo & 3) / 2) as u32,
+                s_c0: ((co & 3) / 2) as u32,
+                ..Default::default()
+            };
+            fn mtl(b: &Buffer) -> &intarsia_backend_metal::MetalBuffer {
+                b.downcast::<intarsia_backend_metal::MetalBuffer>().unwrap()
+            }
+            let (xm, gm, um, cm) = (mtl(&xb), mtl(&gb), mtl(&ub), mtl(&cb));
+            be.with_encoder(|enc| {
+                encode_nax_glu(enc, pso, v, (xm.mtl(), xo & !3), (gm.mtl(), go & !3), (um.mtl(), uo & !3), (cm.mtl(), co & !3), &p)
+            })
+            .unwrap();
+            be.synchronize(0).unwrap();
+            let got = read_u16(&be, &cb, co, m * n);
+            if got != want {
+                let at = got.iter().zip(&want).position(|(a, b)| a != b).unwrap();
+                panic!("{}: m={m} n={n} k={k}: element {at} ({}, {}) differs from pair + silu_glu: {:#06x} vs {:#06x}", v.shader, at / n, at % n, got[at], want[at]);
+            }
+            let raw = read_u16(&be, &cb, 0, (co + m * n * 2 + 16) / 2);
+            assert!(
+                raw[..co / 2].iter().all(|v| *v == 0xEEEE) && raw[(co / 2 + m * n)..].iter().all(|v| *v == 0xEEEE),
+                "{}: guard bytes of the output overwritten (m={m} n={n} k={k})",
+                v.shader
+            );
+        }
+    }
+}
diff --git a/kernels/metal/gemm_nax_bf16.metal b/kernels/metal/gemm_nax_bf16.metal
index a60d45e..7d07970 100644
--- a/kernels/metal/gemm_nax_bf16.metal
+++ b/kernels/metal/gemm_nax_bf16.metal
@@ -101,3 +101,65 @@ NAX_T("gemm_nax_t128x64w4", "gemm_nax_pair_t128x64w4", 128, 64, 4)
 NAX_T("gemm_nax_t32x32w1", "gemm_nax_pair_t32x32w1", 32, 32, 1)
 NAX_T("gemm_nax_t32x128w2", "gemm_nax_pair_t32x128w2", 32, 128, 2)
 NAX_T("gemm_nax_t64x64w2", "gemm_nax_pair_t64x64w2", 64, 64, 2)
+
+// ---- SwiGLU epilogue (P5): out = silu(x Wg^T) * (x Wu^T), one dispatch for gate + up + SiluGlu ----
+// Both products land in bf16 cooperative destinations (the same rounding to bf16 as the pair kernel's stores), then
+// each element becomes silu_glu_bf16's expression on the bf16 values and is stored once.
+template <typename Op, typename TA, typename TW, typename TC>
+inline void nax_glu_run(thread Op& op, TA sA, TW sWg, TW sWu, TC sC) {
+  auto cg = op.template get_destination_cooperative_tensor<TA, TW, bfloat>();
+  auto cu = op.template get_destination_cooperative_tensor<TA, TW, bfloat>();
+  op.run(sA, sWg, cg);
+  op.run(sA, sWu, cu);
+  _Pragma("clang loop unroll(full)")
+  for (ushort i = 0; i < cg.get_capacity(); ++i) {
+    if (cg.is_valid_element(i)) {
+      const float gv = float(cg[i]);
+      cg[i] = bfloat(gv / (1.0f + precise::exp(-gv)) * float(cu[i]));
+    }
+  }
+  cg.store(sC);
+}
+
+template <int BM, int BN, int NSG>
+inline void nax_glu_tile(device bfloat* A, device bfloat* Wg, device bfloat* Wu, device bfloat* C, int M, int N, int K,
+                         int m0, int n0) {
+  tensor<device bfloat, dextents<int, 2>, tensor_inline> tA(A, dextents<int, 2>(K, M));
+  tensor<device bfloat, dextents<int, 2>, tensor_inline> tG(Wg, dextents<int, 2>(K, N));
+  tensor<device bfloat, dextents<int, 2>, tensor_inline> tU(Wu, dextents<int, 2>(K, N));
+  tensor<device bfloat, dextents<int, 2>, tensor_inline> tC(C, dextents<int, 2>(N, M));
+  constexpr auto desc = matmul2d_descriptor(BM, BN, static_cast<int>(dynamic_extent), false, true, false);
+  matmul2d<desc, execution_simdgroups<NSG>> op;
+  if (m0 + BM <= M && n0 + BN <= N) {
+    auto sA = tA.template slice<dynamic_extent, BM>(0, m0);
+    auto sG = tG.template slice<dynamic_extent, BN>(0, n0);
+    auto sU = tU.template slice<dynamic_extent, BN>(0, n0);
+    auto sC = tC.template slice<BN, BM>(n0, m0);
+    nax_glu_run(op, sA, sG, sU, sC);
+  } else {
+    auto sA = tA.slice(0, m0);
+    auto sG = tG.slice(0, n0);
+    auto sU = tU.slice(0, n0);
+    auto sC = tC.slice(n0, m0);
+    nax_glu_run(op, sA, sG, sU, sC);
+  }
+}
+
+// bind: 0 A [M,K], 1 Wg [N,K], 2 Wu [N,K], 3 C [M,N], 4 NaxPairP (n0 = n1 = N; s_w0 / s_w1 the weights' skips, s_c0 C's).
+template <int BM, int BN, int NSG>
+kernel void gemm_nax_glu_t(device bfloat* A [[buffer(0)]], device bfloat* Wg [[buffer(1)]], device bfloat* Wu [[buffer(2)]],
+                           device bfloat* C [[buffer(3)]], constant NaxPairP& p [[buffer(4)]],
+                           uint2 tg [[threadgroup_position_in_grid]]) {
+  const int M = int(p.m), N = int(p.n0), K = int(p.k);
+  const int tiles_m = (M + BM - 1) / BM, tiles_n = (N + BN - 1) / BN;
+  if (int(tg.x) >= tiles_n || int(tg.y) >= tiles_m) return;
+  nax_glu_tile<BM, BN, NSG>(A + p.s_a, Wg + p.s_w0, Wu + p.s_w1, C + p.s_c0, M, N, K, int(tg.y) * BM, int(tg.x) * BN);
+}
+
+#define NAX_GLU(NAME, BM, BN, NSG) \
+  template [[host_name(NAME)]] kernel void gemm_nax_glu_t<BM, BN, NSG>( \
+      device bfloat*, device bfloat*, device bfloat*, device bfloat*, constant NaxPairP&, uint2);
+NAX_GLU("gemm_nax_glu_t64x64w2", 64, 64, 2)
+NAX_GLU("gemm_nax_glu_t64x64w4", 64, 64, 4)
+NAX_GLU("gemm_nax_glu_t128x64w4", 128, 64, 4)
+NAX_GLU("gemm_nax_glu_t32x128w2", 32, 128, 2)
