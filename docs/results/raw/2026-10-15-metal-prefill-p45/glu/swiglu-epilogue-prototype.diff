+/// Encode one `gemm_nax_glu_t` dispatch: `c = silu(a wg^T) * (a wu^T)`; `p.n0` is N (`p.n1` is ignored, `p.s_w0` / `p.s_w1`
+/// are the weights' skips and `p.s_c0` the output's).
+#[allow(clippy::too_many_arguments)]
+pub fn encode_nax_glu(
+    enc: &ProtocolObject<dyn MTLComputeCommandEncoder>,
+    pso: &ProtocolObject<dyn MTLComputePipelineState>,
+    v: &NaxVariant,
+    a: MtlBuf,
+    wg: MtlBuf,
+    wu: MtlBuf,
+    c: MtlBuf,
+    p: &NaxPairParams,
+) {
+    enc.setComputePipelineState(pso);
+    // SAFETY: as `encode_nax`.
+    unsafe {
+        enc.setBuffer_offset_atIndex(Some(a.0), a.1, 0);
+        enc.setBuffer_offset_atIndex(Some(wg.0), wg.1, 1);
+        enc.setBuffer_offset_atIndex(Some(wu.0), wu.1, 2);
+        enc.setBuffer_offset_atIndex(Some(c.0), c.1, 3);
+    }
+    set_bytes(enc, p, 4);
+    enc.dispatchThreadgroups_threadsPerThreadgroup(
+        MTLSize { width: p.n0.div_ceil(v.bn) as usize, height: p.m.div_ceil(v.bm) as usize, depth: 1 },
+        MTLSize { width: v.threads() as usize, height: 1, depth: 1 },
+    );
+}
