/// Holds state for decoding a stream of token IDs into text incrementally.
pub struct IncrementalDecoder {
    ids: Vec<u32>,
    prefix: usize,
    read: usize,
}

/// Provides a default implementation for `IncrementalDecoder`.
impl Default for IncrementalDecoder {
    fn default() -> Self {
        Self::new()
    }
}

impl IncrementalDecoder {
    /// Creates a new `IncrementalDecoder` with empty state.
    pub fn new() -> Self {
        IncrementalDecoder { ids: Vec::new(), prefix: 0, read: 0 }
    }

