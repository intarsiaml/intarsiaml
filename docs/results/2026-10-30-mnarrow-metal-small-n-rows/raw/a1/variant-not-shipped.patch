+/// Pass size of the single launch a 16-row `MatmulPair` call takes instead of two 8-row chunks: `Some(16)` the single-pass
+/// `_mr16x1`, `Some(8)` / `Some(4)` the split-pass `_mr16x1s8` / `s4` (the same bits), `None` the two chunks.
+/// `INTARSIA_METAL_PAIR_ROWS16=0|16|8|4`.
+pub fn pair_rows16() -> Option<usize> {
+    static V: std::sync::OnceLock<Option<usize>> = std::sync::OnceLock::new();
+    *V.get_or_init(|| match std::env::var("INTARSIA_METAL_PAIR_ROWS16").ok().as_deref() {
+        Some("16") => Some(16),
+        Some("8") => Some(8),
+        Some("4") => Some(4),
+        _ => None,
+    })
+}
