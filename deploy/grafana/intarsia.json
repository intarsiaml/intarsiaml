      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(intarsia_uptime_seconds{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "Uptime",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
