        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(intarsia_requests_waiting{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "Waiting",
