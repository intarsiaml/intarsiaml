        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(intarsia_last_decode_tokens_per_second{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "Decode tok/s (last req)",
