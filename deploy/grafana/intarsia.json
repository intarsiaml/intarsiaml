    {
      "id": 7,
      "type": "stat",
      "title": "KV used",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 15,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(intarsia_kv_bytes_used{job=~\"$job\",instance=~\"$instance\"} / intarsia_kv_bytes_total{job=~\"$job\",instance=~\"$instance\"})",
          "legendFormat": "KV used",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "n/a",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6ec878",
                "value": null
              },
              {
                "color": "#e6aa3c",
                "value": 0.7
              },
              {
                "color": "#e0554c",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Wedge",
      "description": "1 when requests are queued or running but the engine has not completed a step in the last minute: a hung kernel keeps /metrics alive while generation is dead (the vLLM cuDNN FP8 hang).",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max((sum(intarsia_requests_running{job=~\"$job\",instance=~\"$instance\"}) + sum(intarsia_requests_waiting{job=~\"$job\",instance=~\"$instance\"}) > bool 0) * (sum(rate(intarsia_engine_steps_total{job=~\"$job\",instance=~\"$instance\"}[1m])) == bool 0))",
          "legendFormat": "Wedge",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "noValue": "n/a",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#6ec878",
                "value": null
              },
              {
                "color": "#e0554c",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Uptime",
